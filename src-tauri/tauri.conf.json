{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcadia Music Forge",
  "version": "17.0.0",
  "identifier": "com.arcadia.musicforge",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arcadia Music Forge",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
